<config xmlns="http://hcmc.uvic.ca/ns/staticSearch" version="2">
   <params>
      <searchPage file="site/search.html"/>
      <index recurse="true"/>
      <stopwords file="bbti_stopwords.txt"/>
      <dictionary file="staticSearch/xsl/english_words.txt"/>
      <scoringAlgorithm name="raw"/>
      <stemmer dir="stemmers/en/"/>
      <tokenizer minWordLength="2"/>
      <createContexts create="true"
                      phrasalSearch="true"
                      wildcardSearch="true"
                      maxKwicLength="10"
                      kwicTruncateString="..."/>
      <results resultsPerPage="200" maxKwicsToShow="3" maxResults="2000"/>
      <version file="gitHash.txt"/>
      <output dir="staticSearch"/>
   </params>
   <rules>
      <rule weight="3" match="h2"/>
      <!--<rule weight="2"
            match="h3"/>-->
      <rule weight="0" match="script | style"/>
      <rule weight="0" match="header"/>
      <rule weight="0" match="h1"/>
      <!-- h4s are all captions. -->
      <rule weight="0" match="h4"/>
      <rule weight="0" match="nav"/>
      <rule weight="0" match="footer"/>
      <rule weight="0" match="span[@class='extraInfo']"/>
      <rule weight="0" match="span[@class='bbtiId']"/>
      <rule weight="0" match="span[@class='countryName']"/>
   </rules>
   <contexts>
      <context match="div[@class='note']" label="Notes"/>
      <context match="div[@class='address']" label="Addresses"/>
      <context match="h3[@class='name']" label="Names"/>
   </contexts>
