    <!-\- Exclude everything that isn't a post. -\->
    <!-\-<exclude type="index" match="html[not(descendant::nav[@class='crumbs'])]"/>-\->
    <!-\-<exclude match="meta[contains-token(@class,'excludedMeta')]" type="filter"/>-\->
  </excludes>-->
</config>
